# Required
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL: set DATABASE_URL for hosted PostgreSQL, or all DB_* values locally
DATABASE_URL=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=replace-me

# Optional integrations; set real values only in local environment or deployment settings
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CHAPA_SECRET_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com

# Set the store's actual fixed delivery fee before accepting paid orders.
# The application defaults to 0 ETB until this is configured.
# Optional bootstrap fallback. Prefer configuring the default in Super Admin > Shipping.
SHIPPING_FEE_ETB=
# Optional override; otherwise the existing settings.cod_enabled value is used.
COD_ENABLED=


# Optional first admin account; no admin is seeded unless both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
